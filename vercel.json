{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "redirects": [
    {
      "source": "/robot.txt",
      "destination": "/robots.txt",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://middelmen-api-e1764610dea5.herokuapp.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://middelmen-api-e1764610dea5.herokuapp.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://middelmen-api-e1764610dea5.herokuapp.com/robots.txt"
    },
    {
      "source": "/:username((?!api/|sitemap\\.xml|robots\\.txt|favicon\\.ico|favicon\\.png|opengraph\\.jpg|llms\\.txt|assets/|illustrations/|auth|verified|verification|verify|forgot-password|reset-password|onboarding|dashboard|my-reviews|admin|search|demo|disabled|access-not-available|about|terms|contact|contacts|v2|.*\\.(?:ico|png|jpg|jpeg|svg|webp|gif|css|js|txt|xml|json|woff2?|ttf|map)$).*)",
      "destination": "https://middelmen-api-e1764610dea5.herokuapp.com/:username"
    },
    {
      "source": "/((?!api/|sitemap\\.xml|robots\\.txt|favicon\\.ico|favicon\\.png|opengraph\\.jpg|llms\\.txt|assets/|illustrations/|.*\\.(?:ico|png|jpg|jpeg|svg|webp|gif|css|js|txt|xml|json|woff2?|ttf|map)$).*)",
      "destination": "/index.html"
    }
  ]
}


