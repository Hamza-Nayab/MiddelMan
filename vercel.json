{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-HEROKU-APP.herokuapp.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://YOUR-HEROKU-APP.herokuapp.com/sitemap.xml"
    },
    {
      "source": "/((?!api/|sitemap\\.xml|assets/|illustrations/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}

